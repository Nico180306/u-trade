# Backend API (en desarrollo y producción pasa por el proxy /api)
VITE_API_BASE_URL=/api/v1

# Proxy local de Vite (solo desarrollo; NO se expone al bundle del navegador)
VITE_DEV_API_TARGET=http://localhost:8000
INTERNAL_PROXY_SECRET=dev-local-proxy-secret

# Sentry (proyecto u-trade-frontend)
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
