# Django Core
DJANGO_SETTINGS_MODULE=config.settings.local
DEBUG=True
SECRET_KEY=change-me-local-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1

# Proxy Edge (Cloudflare Pages Function) y Cron (GitHub Actions)
INTERNAL_PROXY_SECRET=dev-local-proxy-secret
CRON_SECRET=dev-local-cron-secret

# CORS, CSRF & Frontend
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# PostgreSQL 16 (Neon - rama development en local; en produccion usar el host -pooler)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# PostgreSQL 16 LOCAL para pytest (servicio postgres-test de docker-compose). Nunca Neon.
TEST_DATABASE_URL=postgres://utrade:utrade@localhost:5433/utrade_test

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Sentry (proyecto u-trade-backend)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
